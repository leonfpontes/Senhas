# ============================================================
# .env.prod.example — Template de ambiente para PRODUÇÃO
# Copie para .env e preencha com valores reais.
# NUNCA commite o .env com valores reais.
# ============================================================

# ========== Domínio & Infraestrutura ==========
DOMAIN=girahub.com.br
CERTBOT_EMAIL=admin@girahub.com.br

# Registry de imagens Docker (deixe "senhas" para build local no VPS)
REGISTRY=senhas
APP_VERSION=1.1.0

# ========== Banco de Dados ==========
DB_NAME=senhas_prod
DB_USER=senhas_user
# Gere com: openssl rand -hex 32
DB_PASSWORD=SUBSTITUA_POR_SENHA_FORTE

# URL completa (usada pelo backend)
DATABASE_URL=postgresql+asyncpg://senhas_user:SUBSTITUA_POR_SENHA_FORTE@postgres:5432/senhas_prod

# ========== Redis ==========
# Gere com: openssl rand -hex 32
REDIS_PASSWORD=SUBSTITUA_POR_SENHA_REDIS

# ========== JWT & Segurança ==========
# Gere com: openssl rand -hex 32
SECRET_KEY=SUBSTITUA_POR_SECRET_KEY
JWT_SECRET=SUBSTITUA_POR_JWT_SECRET

# ========== Email — Brevo (primário) ==========
BREVO_API_KEY=xkeysib-SUBSTITUA_PELA_SUA_CHAVE
BREVO_SENDER_EMAIL=noreply@girahub.com.br
BREVO_SENDER_NAME=GiraHub

# ========== Email — Resend (fallback) ==========
RESEND_API_KEY=re_SUBSTITUA_PELA_SUA_CHAVE
RESEND_SENDER_EMAIL=noreply@girahub.com.br

# ========== Frontend ==========
# URL pública da API (mesma domain, path /api/)
API_URL=https://girahub.com.br
NEXT_PUBLIC_API_URL=https://girahub.com.br/api
NEXT_PUBLIC_APP_NAME=GiraHub

# ========== CORS ==========
CORS_ORIGINS=https://girahub.com.br,https://www.girahub.com.br

# ========== Sentry (monitoramento de erros) ==========
# Crie um projeto em https://sentry.io e copie o DSN aqui.
# Deixe em branco para desabilitar Sentry (dev local / ambientes sem configuração).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# Para upload de source maps no CI (opcional):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ========== Monitoramento ==========
# Gere com: openssl rand -base64 16
GRAFANA_PASSWORD=SUBSTITUA_POR_SENHA_GRAFANA

# ========== Super Admin inicial (usado apenas no seed_superadmin.py) ==========
# Não precisa ficar no .env permanente — use apenas uma vez no deploy inicial
SUPERADMIN_EMAIL=admin@girahub.com.br
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_12_CHARS_MIN

# ========== LGPD ==========
DEFAULT_DATA_RETENTION_DAYS=365
DEFAULT_TIMEZONE=America/Sao_Paulo
