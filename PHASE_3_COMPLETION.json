  "api_endpoints": {
    "next_gira": {
      "method": "GET",
      "path": "/api/v1/public/next-gira",
      "parameters": ["tenant_slug"],
      "response_fields": ["id", "name", "location", "release_start_at", "release_end_at", "max_tickets", "current_tickets", "tickets_available", "is_open"],
      "errors": ["404 Tenant not found", "404 No active gira"]
    },
    "emit_ticket": {
      "method": "POST",
      "path": "/api/v1/public/emit-ticket",
      "parameters": ["tenant_slug"],
      "body_fields": ["name", "email", "phone (optional)"],
      "response_fields": ["ticket_number", "email_sent", "rescue_link", "message"],
      "errors": ["400 Invalid email", "404 Tenant/gira not found", "409 Duplicate", "429 Capacity reached"],
      "background_tasks": ["Send email via Brevo/Resend"]
    },
    "resend_email": {
      "method": "POST",
      "path": "/api/v1/public/resend-ticket-email",
      "parameters": ["tenant_slug"],
      "body_fields": ["email", "phone (optional)"],
      "response_fields": ["tickets_count", "email_sent", "message"],
      "errors": ["400 Invalid email", "404 Tenant/no tickets found"]
    }
  },

