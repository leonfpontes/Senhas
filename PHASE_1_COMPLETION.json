      "backend": [
        "cd backend",
        "python -m venv venv",
        "source venv/bin/activate  # Windows: venv\\Scripts\\activate",
        "pip install -e '.[dev]'",
        "uvicorn app.main:app --reload"
      ],
      "frontend": [
        "cd frontend",
        "npm install",
        "npm run dev"
      ]
    }
