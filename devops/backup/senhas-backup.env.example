# Copiar para /etc/senhas-backup.env na VPS e `chmod 600`. Não versionar o arquivo real.
PROJECT_DIR=/opt/senhas
LOCAL_DIR=/opt/senhas/backups/daily

# Id ou e-mail da chave PÚBLICA gpg importada na VPS (`gpg --import girahub-backup.pub.asc`).
# A chave privada fica só com o dono (gerenciador de senhas + cópia offline).
GPG_RECIPIENT=backup@girahub.com.br

# Remote do rclone (`rclone config` na VPS) + bucket. Ex.: Cloudflare R2 ou Backblaze B2.
# Use uma chave de API restrita a este bucket.
RCLONE_REMOTE=r2:girahub-backups

KEEP_LOCAL=7
KEEP_DAILY_DAYS=30
KEEP_MONTHLY=12
