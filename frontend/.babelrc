{
  "presets": ["next/babel"],
  "plugins": [
    ["@babel/plugin-transform-react-jsx", { "runtime": "automatic" }],
    "@babel/plugin-transform-class-properties",
    "@babel/plugin-transform-numeric-separator"
  ],
  "env": {
    "development": {
      "plugins": ["@babel/plugin-transform-react-jsx-source"]
    }
  }
}
