{
  // Gate de vulnerabilidades JS do frontend (roda no job Security Audit do
  // deploy.yml). Substitui `npm audit --audit-level=high` cru pra poder ter
  // allowlist por advisory — o `npm audit` nao tem isso, ao contrario do
  // pip-audit no backend.

  // Falha em high e critical (equivale ao --audit-level=high anterior).
  "high": true,

  // Audita so dependencias de producao. Ferramentas de dev/build (eslint,
  // jest, browserslist, etc.) nao vao pro runtime servido aos usuarios —
  // mesmo criterio do backend, cujo pip-audit ve so runtime (pip install .).
  "skip-dev": true,

  // Advisories de PRODUCAO que so se corrigem com um major do framework:
  //   - next 14.2.35 -> 15/16 (o 14.2.x ja esta no ultimo patch; nao ha fix
  //     nao-breaking). 21 advisories (DoS/SSRF/XSS/cache-poisoning).
  //   - postcss (4) vem transitivo do next, so sai com o major do next.
  //   - rollup (1) vem do @sentry/nextjs; sai com @sentry/nextjs 8 -> 10.
  // Suprimidas aqui TEMPORARIAMENTE pra destravar o gate, e rastreadas na
  // task de upgrade do Next/Sentry. Novos advisories fora desta lista ainda
  // quebram o build — remover cada ID conforme o upgrade for feito.
  "allowlist": [
    "GHSA-9g9p-9gw9-jx7f",
    "GHSA-h25m-26qc-wcjf",
    "GHSA-ggv3-7p47-pfv8",
    "GHSA-3x4c-7xq6-9pq8",
    "GHSA-q4gf-8mx6-v5v3",
    "GHSA-8h8q-6873-q5fj",
    "GHSA-3g8h-86w9-wvmq",
    "GHSA-ffhc-5mcf-pf4q",
    "GHSA-vfv6-92ff-j949",
    "GHSA-gx5p-jg67-6x7h",
    "GHSA-h64f-5h5j-jqjh",
    "GHSA-c4j6-fc7j-m34r",
    "GHSA-wfc6-r584-vfw7",
    "GHSA-36qx-fr4f-26g5",
    "GHSA-m99w-x7hq-7vfj",
    "GHSA-89xv-2m56-2m9x",
    "GHSA-68g3-v927-f742",
    "GHSA-4633-3j49-mh5q",
    "GHSA-4c39-4ccg-62r3",
    "GHSA-p9j2-gv94-2wf4",
    "GHSA-955p-x3mx-jcvp",
    "GHSA-qx2v-qp2m-jg93",
    "GHSA-6g55-p6wh-862q",
    "GHSA-fxqj-rqcc-2cmp",
    "GHSA-r28c-9q8g-f849",
    "GHSA-mw96-cpmx-2vgc"
  ]
}
