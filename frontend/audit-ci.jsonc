{
  // Gate de vulnerabilidades JS do frontend (roda no job Security Audit do
  // deploy.yml). Substitui `npm audit --audit-level=high` cru pra poder ter
  // allowlist por advisory — o `npm audit` nao tem isso, ao contrario do
  // pip-audit no backend.

  // Falha em high e critical (equivale ao --audit-level=high anterior).
  "high": true,

  // Audita so dependencias de producao. Ferramentas de dev/build (eslint,
  // jest, browserslist, etc.) nao vao pro runtime servido aos usuarios —
  // mesmo criterio do backend, cujo pip-audit ve so runtime (pip install .).
  "skip-dev": true,

  // Residual apos o upgrade do Next 14 -> 15.5.25 (que limpou os 21 advisories
  // de PRODUCAO do next: DoS/SSRF/XSS/cache-poisoning). Sobram so ferramentas
  // de BUILD, que processam entrada confiavel (nosso proprio codigo) e nao vao
  // pro runtime servido aos usuarios:
  //   - postcss (4): processador de CSS pinado pelo next@15.5.25 em 8.4.31; as
  //     advisories dependem de CSS malicioso, que nao existe no build. Sai
  //     quando o next subir o postcss (previsto num next futuro).
  //   - rollup (1): bundler usado pelo @sentry/nextjs no build; sai com o
  //     @sentry/nextjs 8 -> 10.
  // Novos advisories fora desta lista ainda quebram o build. Rastreado na task
  // do @sentry/nextjs 8 -> 10; remover cada ID conforme os parents subirem.
  "allowlist": [
    "GHSA-qx2v-qp2m-jg93",
    "GHSA-6g55-p6wh-862q",
    "GHSA-fxqj-rqcc-2cmp",
    "GHSA-r28c-9q8g-f849",
    "GHSA-mw96-cpmx-2vgc"
  ]
}
