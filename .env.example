# ========================================
# Environment Configuration Template
# Copy to .env and fill in your values
# ========================================

# ========== Database ==========
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=senhas_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password_here@localhost:5432/senhas_dev

# ========== JWT & Security ==========
JWT_SECRET_KEY=your_super_secret_jwt_key_min_32_chars_recommended
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ========== Backend ==========
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
LOG_LEVEL=INFO

# ========== Frontend ==========
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Senhas Sistema

# ========== Email Service ==========
# Brevo (SendinBlue)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@senhas.app
BREVO_SENDER_NAME=Sistema de Senhas

# Resend (Fallback)
RESEND_API_KEY=your_resend_api_key_here

# ========== LGPD & Compliance ==========
DEFAULT_DATA_RETENTION_DAYS=365
DEFAULT_TIMEZONE=America/Sao_Paulo

# ========== Rate Limiting ==========
RATE_LIMIT_PUBLIC_EMISSION=5
RATE_LIMIT_PUBLIC_RESEND=2
RATE_LIMIT_ADMIN=100

# ========== CORS & Security ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ========== Development ==========
DEBUG=false
ENVIRONMENT=development

# ========== Features (Feature Flags) ==========
FEATURE_SUPER_ADMIN=false
FEATURE_ANALYTICS=false
FEATURE_PAYMENT=false
